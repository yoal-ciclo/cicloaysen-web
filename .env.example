# Formulario de contacto (FormSubmit no requiere key, pero se puede migrar a EmailJS)
# EMAIL_SERVICE_KEY=tu_api_key_aqui

# URL del sitio (usada en sitemap y OG tags)
NEXT_PUBLIC_SITE_URL=https://cicloaysen.com

# Postulaciones laborales (/trabaja-con-nosotros) — envío de correos con Resend
# Clave de API de Resend (https://resend.com/api-keys). Configúrela en Vercel, nunca en el repositorio.
RESEND_API_KEY=
# Destinatario de las postulaciones (puede ser una lista separada por comas)
POSTULACIONES_EMAIL_TO=contacto@cicloaysen.com
# Remitente; el dominio debe estar verificado en Resend
POSTULACIONES_EMAIL_FROM="Postulaciones Ciclo Aysén <postulaciones@cicloaysen.com>"
